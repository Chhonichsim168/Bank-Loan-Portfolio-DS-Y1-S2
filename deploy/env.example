# Copy to .env / set in your service manager. Nothing here is required for a trial run.
CREDIT_DESK_REQUIRE_MFA=1            # make multi-factor sign-in mandatory for everyone
CREDIT_DESK_SESSION_MINUTES=15       # idle timeout
CREDIT_DESK_RETENTION_DAYS=90        # how long superseded data extracts are kept
CREDIT_DESK_SINGLE_OPERATOR=0        # 1 = allow self-approval of policy (tiny teams ONLY; recorded in audit)
# CREDIT_DESK_ADMIN_PASSWORD=...     # optional: choose the first admin's one-time password yourself
# CREDIT_DESK_USERS_FILE, CREDIT_DESK_AUDIT_DB, CREDIT_DESK_MODEL_DIR  # relocate state onto a mounted volume
