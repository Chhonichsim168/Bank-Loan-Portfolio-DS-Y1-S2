# Credit Desk — example reverse proxy.
#
# Streamlit binds to 127.0.0.1 only (see .streamlit/config.toml) and never speaks TLS
# itself. This is the piece that actually faces the network: it terminates HTTPS with a
# real certificate and forwards to the app over loopback. Replace the hostname and
# certificate paths, then drop this in /etc/nginx/sites-available/.

server {
    listen 443 ssl http2;
    server_name credit-desk.internal.example-bank.com;

    ssl_certificate     /etc/ssl/certs/credit-desk.crt;
    ssl_certificate_key  /etc/ssl/private/credit-desk.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        # Streamlit's live UI runs over a websocket — without this upgrade it will load
        # once and then never update.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Redirect any plain-HTTP request to HTTPS instead of serving the app over it.
server {
    listen 80;
    server_name credit-desk.internal.example-bank.com;
    return 301 https://$host$request_uri;
}
