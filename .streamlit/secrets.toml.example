# Copy these lines into the "Secrets" box of your hosting service
# (Streamlit Community Cloud: App settings > Secrets), or into .streamlit/secrets.toml.
# Every line is optional. Remove the "# " in front of a line to use it.
# TOML rule: the single CREDIT_DESK_... lines must come BEFORE the [sections] at the bottom.

# Gmail addresses that become Administrators the first time they press "Continue with Google"
# (comma separated). Everyone else who signs up with Google becomes a Customer; an Administrator
# can change roles in User management.
# CREDIT_DESK_ADMIN_EMAILS = "you@gmail.com, teammate@gmail.com"

# Your fixed ngrok address, used by "START Credit Desk ONLINE" (see GO ONLINE WITH NGROK (Khmer).md).
# CREDIT_DESK_PUBLIC_DOMAIN = "credit-desk-g4.ngrok-free.app"

# Sign-in page with the simple accounts admin/admin123, risk/risk123, officer/officer123 (default).
# For a site other people can reach, create real accounts instead: the first start then makes ONE
# admin whose password you choose below (you are asked to replace it at first sign-in).
# CREDIT_DESK_DEMO_USERS = "0"
# CREDIT_DESK_ADMIN_PASSWORD = "choose-a-long-password-here"

# Lock an account for 15 minutes after 5 wrong passwords (recommended on a public site).
# CREDIT_DESK_LOCKOUT = "1"

# Start without the sample loans and decisions.
# CREDIT_DESK_SAMPLE_DATA = "0"

# Sign people out after 20 idle minutes by default.
# CREDIT_DESK_AUTO_LOGOUT = "1"


# ---- Sign in with Google -------------------------------------------------------------------
# From Google Cloud Console > Google Auth Platform > Clients (type "Web application").
# The redirect URI must be listed there EXACTLY as written here. On your own computer Credit Desk
# must run at port 8501; on Streamlit Community Cloud use https://<your-app>.streamlit.app/oauth2callback
# cookie_secret: any long random text (keeps the Google sign-in cookie safe).
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "paste-a-long-random-text-here"
#
# [auth.google]
# client_id = "xxxxxxxx.apps.googleusercontent.com"
# client_secret = "GOCSPX-xxxxxxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- Email codes (sign-up verification + Forgot password by email) --------------------------
# A Gmail account with 2-Step Verification ON and an "App password" (Google Account > Security >
# App passwords). Use the 16-letter App password, NOT the normal Gmail password.
# [email]
# sender = "creditdesk.g4@gmail.com"
# password = "abcd efgh ijkl mnop"

# ---- Real KHQR payments (customer portal > Pay) ------------------------------------------------
# static_qr: the TEXT inside your bank app's receive-money KHQR (ABA: Receive money > ABA KHQR).
#   Money paid with the portal's QR goes straight to that account.
# token: Bakong Open API token from https://api-bakong.nbc.gov.kh (starts with eyJ...). With it the
#   portal confirms payments automatically; without it the customer presses "I have paid" and a
#   staff member confirms in Customer requests > Verify customer payments.
#   Bakong only answers computers in Cambodia - run Credit Desk on your own computer for this.
# test_amount: while testing, the QR charges this amount but the full amount is recorded on the loan.
# [bakong]
# static_qr = "00020101021129..."
# currency = "USD"
# token = "eyJ..."
# test_amount = 0.01
