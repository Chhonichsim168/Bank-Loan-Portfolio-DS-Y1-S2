# Copy these lines into the "Secrets" box of your hosting service
# (Streamlit Community Cloud: App settings > Secrets), or into .streamlit/secrets.toml.
# Every line is optional. Remove the "# " in front of a line to use it.

# Sign-in page with the simple accounts admin/admin123, risk/risk123, officer/officer123 (default).
# For a site other people can reach, create real accounts instead: the first start then makes ONE
# admin whose password you choose below (you are asked to replace it at first sign-in).
# CREDIT_DESK_DEMO_USERS = "0"
# CREDIT_DESK_ADMIN_PASSWORD = "choose-a-long-password-here"

# Lock an account for 15 minutes after 5 wrong passwords (recommended on a public site).
# CREDIT_DESK_LOCKOUT = "1"

# Start without the sample loans and decisions.
# CREDIT_DESK_SAMPLE_DATA = "0"

# Sign people out after 20 idle minutes by default.
# CREDIT_DESK_AUTO_LOGOUT = "1"
